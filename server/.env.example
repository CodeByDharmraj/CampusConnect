# Development server
NODE_ENV=development
PORT=5000

# Number of trusted reverse-proxy hops (keep 0 unless deployment requires a proxy)
TRUST_PROXY_HOPS=0

# Frontend origin allowed to access the API
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=

# Generate strong, independent secrets before production deployment
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Cookie configuration
COOKIE_SECURE=false

COOKIE_SAME_SITE=lax



# Cloudflare R2 - Private assignment submission storage
# Keep these empty until the R2 bucket and API credentials are configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=


# Development-only demo seeding. Never enable this in production.
ALLOW_DEMO_SEED=false
SEED_ACADEMIC_YEAR=2026-2027
SEED_SEMESTER=5

# Required only when the corresponding demo account does not already exist.
# Use unique local-development passwords; never reuse production credentials.
SEED_ADMIN_PASSWORD=
SEED_FACULTY_PASSWORD=
SEED_COORDINATOR_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_2_PASSWORD=
