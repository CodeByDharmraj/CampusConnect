# Development server
NODE_ENV=development
PORT=5000

# Frontend origin allowed to access the API
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=

# Generate strong, independent secrets before production deployment
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Cookie configuration
COOKIE_SECURE=false

COOKIE_SAME_SITE=lax



# Cloudflare R2 - Private assignment submission storage
# Keep these empty until the R2 bucket and API credentials are configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=campusconnect-submissions
R2_ENDPOINT=
