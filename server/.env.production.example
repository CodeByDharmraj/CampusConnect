# Production API configuration — set values in the hosting provider's secret manager.
NODE_ENV=production
PORT=5000

# Set only to the actual trusted proxy hop count for your hosting topology.
TRUST_PROXY_HOPS=0

# Exact deployed frontend origin, with no trailing path.
CLIENT_ORIGIN=https://your-campusconnect-frontend.example

# Atlas connection string. Use a dedicated least-privilege application DB user.
MONGODB_URI=

# Generate two different random secrets, each at least 32 bytes.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# For cross-site frontend/backend deployments, use Secure cookies and SameSite=None.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Configure all five R2 values together, or leave all five empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
